      "1606935814649c2e53": {
        "type": "hero",
        "settings": {
          "full_width": false,
          "image": "shopify://shop_images/image3.jpg",
          "alignment": "center",
          "title": "GIFT CARDS",
          "text": "<p>for in-store or online </p><p></p>",
          "hero_size": "x-small",
          "button_label": "BUY NOW",
          "button_link": "shopify://products/gift-card",
          "color_overlay": "#4b4b4b",
