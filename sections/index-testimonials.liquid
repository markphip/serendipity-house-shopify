<div class="slideshow slideshow-{{ section.id }} section-standard no-border" data-section-id="{{ section.id }}" data-section-type="slideshow-section">
  <div class="contain-site-width no-padding">
    <div class="wrapper">
      <div class="content text-center rte">
        {% if section.settings.title != blank %}
          <h2>{{ section.settings.title | escape }}</h2>
        {% endif %}
      </div>
      
      {% if section.settings.autoplay %}
        {% assign autoplay = section.settings.autoplay_speed_range | times: 1000 %}
      {% else %}
        {% assign autoplay = false %}
      {% endif %}
      <div class="slideshow-carousel"
        data-slide-count="{{ section.blocks.size }}"
        data-flickity-options='{
          "lazyLoad": 1,
          "adaptiveHeight": true,
          "autoPlay": {{ section.settings.autoplay }},
          "wrapAround": true,
          "prevNextButtons": true,
          "pageDots": false
        }'>
        
          {% for block in section.blocks %}
          <div id="block-{{ block.id }}" class="slide__item slide__item-{{ block.type }}" data-slide-index="{{ forloop.index0 }}" {% if block.type == 'video' %}data-video-id="{{ block.settings.video_url.id }}" data-mobile-autoplay="{{ block.settings.mobile_autoplay }}"{% endif %} {{ block.shopify_attributes }}>
            <blockquote>
              <div class="richtext">
                <svg class="start" aria-hidden="true" focusable="false" role="presentation" class="icon icon-quote" viewBox="0 0 41 35"><path d="M10.208 17.711h6.124v16.332H0V21.684C0 8.184 5.444.956 16.332 0v6.125c-4.083 1.14-6.124 4.414-6.124 9.82v1.766zm24.498 0h6.124v16.332H24.498V21.684C24.498 8.184 29.942.956 40.83 0v6.125c-4.083 1.14-6.124 4.414-6.124 9.82v1.766z" fill="#000" fill-rule="evenodd"/></svg>
                {{ block.settings.text }}
                <svg class="end" aria-hidden="true" focusable="false" role="presentation" class="icon icon-quote" viewBox="0 0 41 35"><path d="M10.208 17.711h6.124v16.332H0V21.684C0 8.184 5.444.956 16.332 0v6.125c-4.083 1.14-6.124 4.414-6.124 9.82v1.766zm24.498 0h6.124v16.332H24.498V21.684C24.498 8.184 29.942.956 40.83 0v6.125c-4.083 1.14-6.124 4.414-6.124 9.82v1.766z" fill="#000" fill-rule="evenodd"/></svg>
              </div>
              
              {% if block.settings.author != blank %}
              <strong>{{ block.settings.author }}</strong>
              {% endif %}
            </blockquote>
          </div>
          {% endfor %}
      </div>
      <ol class="flickity-page-dots placeholder">
        {%- for block in section.blocks -%}
          {%- if forloop.first -%}
            <li class="dot is-selected"></li>
          {%- else -%}
            <li class="dot"></li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    </div>
  </div>
</div>

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
  }
</style>

{% schema %}
  {
    "name": "Testimonials",
    "class": "index-testimonials",
    "max_blocks": 9,
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Background color",
        "default": "#ffffff"
      },
      {
        "type": "text",
        "id": "title",
        "label": "Heading",
        "default": "Testimonials"
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Auto-rotate slides",
        "default": true
      },
      {
        "type": "range",
        "id": "autoplay_speed_range",
        "label": "Change slides every",
        "min": 3,
        "max": 10,
        "step": 1,
        "unit": "sec",
        "default": 5
      }
    ],
    "blocks": [
      {
        "type": "testimonial",
        "name": "Testimonial",
        "settings": [
          {
            "type": "richtext",
            "id": "text",
            "label": "Text",
            "default": "<p>Add customer reviews and testimonials to showcase your store’s happy customers.</p>"
          },
          {
            "type": "text",
            "id": "author",
            "label": "Author",
            "default": "Author's name"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Testimonials",
        "category": "Text",
        "blocks": [
          {
            "type": "testimonial"
          },
          {
            "type": "testimonial"
          },
          {
            "type": "testimonial"
          }
        ]
      }
    ]
  }
{% endschema %}
